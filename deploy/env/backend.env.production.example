# Copy to /etc/shopsmart/backend.env on the server (01-server-setup.sh does this for you).
# Never commit the real file. Never put these values in a VITE_ variable.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
FRONTEND_URL=https://YOUR_DOMAIN
DATABASE_URL="postgresql://shopsmart_user:CHANGE_ME@localhost:5432/shopsmart?schema=public"
# At least 32 random characters: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME
# Optional. Leave empty to use catalog-verified rule-based assistant answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
