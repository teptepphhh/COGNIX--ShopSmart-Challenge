# Server-only settings. Copy to backend/.env and never commit the real file.
DATABASE_URL="postgresql://shopsmart_user:shopsmart_dev@localhost:5432/shopsmart?schema=public"
PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
# Required in production: at least 32 random characters, e.g. `openssl rand -hex 32`.
SESSION_SECRET=
# Production only: bind to 127.0.0.1 so the API is reachable only through Nginx.
HOST=
# Optional AI provider. Leave empty to use the catalog-verified rule-based answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
