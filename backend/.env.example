DATABASE_URL="postgresql://shopsmart_user:shopsmart_dev@localhost:5432/shopsmart?schema=public"
PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# LAB 5 AI assistant (server only). Put your real key in backend/.env, never here.
# Leave GEMINI_API_KEY empty (or set AI_PROVIDER=none) to use the rule-based answers only.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=8000
